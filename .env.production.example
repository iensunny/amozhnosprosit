# Copy to .env on the new server. Replace every placeholder before starting.
DOMAIN=app.example.ru
PUBLIC_APP_URL=https://app.example.ru
SQLITE_PATH=/var/lib/amozhnosprosit/amozhnosprosit.sqlite
MAX_BOT_TOKEN=replace-with-the-existing-MAX-bot-token
MAX_BOT_NAME=se14681938_bot
# SHA-256 of the monitoring password used for Basic Auth. Keep the actual password separately.
STATUS_DASHBOARD_PASSWORD_SHA256=replace-with-64-character-hex-sha256

# Keep both false while testing the new server. Enable only at production cutover.
MAX_WEBHOOK_SETUP_ENABLED=false
ENABLE_SCHEDULED_JOBS=false
